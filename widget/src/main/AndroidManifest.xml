<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WG-03: 자정에 오늘 칸을 옮기는 정확한 알람(캘린더 앱 용도, 설치 시 자동 허용). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 재부팅 후 자정 알람 재예약. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <receiver
            android:name=".NotionCalWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notioncal_widget_info" />
        </receiver>

        <!-- WG-06 보조 위젯(오늘·다가오는 7일). -->
        <receiver
            android:name=".AgendaWidgetReceiver"
            android:exported="true"
            android:label="@string/agenda_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agenda_widget_info" />
        </receiver>

        <!-- WG-09 달력 + 일정(왼쪽 미니 월 달력, 오른쪽 일정 목록). -->
        <receiver
            android:name=".SplitWidgetReceiver"
            android:exported="true"
            android:label="@string/split_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/split_widget_info" />
        </receiver>

        <!-- HB-03 습관 위젯. -->
        <receiver
            android:name=".HabitWidgetReceiver"
            android:exported="true"
            android:label="@string/habit_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>

        <!-- LD-03 가계부 달력 위젯. -->
        <receiver
            android:name=".LedgerWidgetReceiver"
            android:exported="true"
            android:label="@string/ledger_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ledger_widget_info" />
        </receiver>

        <!-- DD-03 디데이 1×1. -->
        <receiver
            android:name=".DdaySmallWidgetReceiver"
            android:exported="true"
            android:label="@string/dday_small_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_small_widget_info" />
        </receiver>

        <!-- DD-04 디데이 2×1. -->
        <receiver
            android:name=".DdayWideWidgetReceiver"
            android:exported="true"
            android:label="@string/dday_wide_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_wide_widget_info" />
        </receiver>

        <!-- DD-05 디데이 목록. -->
        <receiver
            android:name=".DdayListWidgetReceiver"
            android:exported="true"
            android:label="@string/dday_list_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dday_list_widget_info" />
        </receiver>

        <!-- VW-03 노션 보기 위젯. -->
        <receiver
            android:name=".ViewWidgetReceiver"
            android:exported="true"
            android:label="@string/view_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/view_widget_info" />
        </receiver>

        <!-- Phase 11d 노션 위젯(보기 하나·탭·섹션). -->
        <receiver
            android:name=".LayoutWidgetReceiver"
            android:exported="true"
            android:label="@string/layout_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/layout_widget_info" />
        </receiver>

        <!-- M5a 책 갤러리 위젯(표지 + 읽은 비율). -->
        <receiver
            android:name=".BookWidgetReceiver"
            android:exported="true"
            android:label="@string/book_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/book_widget_info" />
        </receiver>

        <!-- WG-11 통합 탭 위젯(📅 일정 · ✅ 습관 · 💰 가계부). -->
        <receiver
            android:name=".TabbedWidgetReceiver"
            android:exported="true"
            android:label="@string/tabbed_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tabbed_widget_info" />
        </receiver>

        <receiver
            android:name=".DayChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Phase 11h: 레시피로 놓은 노션 위젯의 핀 성공 콜백(런처가 위젯 번호를 덧붙여 보낸다). 앱 안에서만 부른다. -->
        <receiver
            android:name=".RecipePinReceiver"
            android:exported="false" />

        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
