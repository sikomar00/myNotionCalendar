<?xml version="1.0" encoding="utf-8"?>
<!--
  HB-03 습관 위젯: 기본 4×2, 최소 2×2(오늘 체크만), 4×4는 이번 달 잔디까지.
  모양 설정(테마·투명도·글자)은 선택이다: 놓을 때 화면 없이 기본값으로 놓이고, 길게 눌러 '설정'에서 바꾼다.
  updatePeriodMillis=0: 데이터 변경·자정 알람이 갱신을 요청한다.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.ysdoing.notioncal.widget.WidgetConfigActivity"
    android:description="@string/habit_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_preview_habit"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
