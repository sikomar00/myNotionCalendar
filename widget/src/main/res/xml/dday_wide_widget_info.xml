<?xml version="1.0" encoding="utf-8"?>
<!--
  DD-04 디데이 2×1: 숫자 + 제목 + 날짜. 줄이면 1×1 모양으로 바뀐다.
  updatePeriodMillis=0: 데이터 변경·자정 알람(WG-03)이 갱신을 요청한다.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.ysdoing.notioncal.widget.WidgetConfigActivity"
    android:description="@string/dday_wide_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_preview_dday"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
