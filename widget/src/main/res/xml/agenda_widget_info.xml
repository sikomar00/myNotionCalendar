<?xml version="1.0" encoding="utf-8"?>
<!--
  WG-06: 기본 4×2, 최소 2×2, 가로·세로 크기 조절. 설정은 월 위젯과 같은 화면을 쓴다(WG-04).
  updatePeriodMillis=0: 데이터 변경·자정 알람이 갱신을 요청한다.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.ysdoing.notioncal.widget.WidgetConfigActivity"
    android:description="@string/agenda_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
