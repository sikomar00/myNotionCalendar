<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- EX-02: 폰의 공휴일 캘린더(구글 '대한민국의 휴일' 등)만 읽는다. 다른 캘린더 일정은 읽지 않는다. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- EX-01 일정 알림(Android 13+ 런타임 권한). 정확한 알람(USE_EXACT_ALARM)·부팅 수신은 위젯 모듈 매니페스트에 있다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NotionCalApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotionCal">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PF-04: Sentry는 NotionCalApp에서 DSN이 있을 때만 백그라운드로 초기화한다. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- Hilt WorkerFactory를 쓰려고 WorkManager 기본 초기화를 끈다(NotionCalApp이 Configuration.Provider). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- EX-01 알림 발화·다시 걸기(부팅·시간 변경·앱 업데이트). -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- EX-01 알림의 '완료' 버튼. -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />
    </application>

</manifest>
